{
  "name": "arif-coskun-platform",
  "version": "1.0.0",
  "description": "Arif Coskun — Senior Systems Architect & Autonomous AI Engineer Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:quality-gate": "npx tsx test/verify-quality-gate.ts",
    "test:all": "npm run test && npm run test:e2e && npm run test:quality-gate",
    "deploy:pages": "npm run build && npx wrangler pages deploy dist --project-name=arif-coskun-platform --branch=main --commit-dirty=true",
    "deploy:gcp": "./deploy-gcp.sh"
  },
  "keywords": [
    "systems-architect",
    "autonomous-ai",
    "microsoft-fabric",
    "mindball",
    "beqom"
  ],
  "author": "Arif Coskun",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsdom": "^30.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^6.2.0",
    "vitest": "^4.1.10"
  }
}
